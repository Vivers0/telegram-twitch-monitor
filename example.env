# ===== Telegram =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ===== Twitch =====
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
# Должен ТОЧНО совпадать с OAuth Redirect URL в Twitch Developer Console
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# ===== Сервер =====
PORT=3000

# ===== Интервалы (мс) =====
# Проверка статуса стримов
INTERVAL=10000
# Проверка новых подписок/отписок Twitch
FOLLOWS_CHECK_INTERVAL=300000

# ===== База данных =====
# Путь к файлу SQLite (в Docker хранится в ./data через volume)
DB_PATH=./data/database.db

# ===== Прокси (опционально) =====
# Применяется ТОЛЬКО к запросам Telegram API; Twitch идёт напрямую.
# Поддержка: http, https, socks4, socks5
# PROXY_URL=socks5://user:pass@host:port
